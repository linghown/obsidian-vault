properties:
  file.name:
    displayName: 文件
  file.folder:
    displayName: 所在文件夹
  file.ext:
    displayName: 类型
  file.mtime:
    displayName: 修改时间
views:
  - type: table
    name: 收件箱
    filters:
      and:
        - file.inFolder("收件箱")
        - file.ext == "md"
        - file.path != "收件箱/收件箱.md"
    order:
      - file.name
      - file.folder
      - file.ext
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    limit: 300
  - type: table
    name: 领域
    filters:
      and:
        - file.inFolder("领域")
        - file.ext == "md"
        - file.path != "领域/领域.md"
    order:
      - file.name
      - file.folder
      - file.ext
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    limit: 300
